#. Plugin Name of the plugin
#: simple-redis-cache.php includes/class-simple-redis-cache-admin.php:48
#: includes/class-simple-redis-cache-admin.php:267
msgid "Simple Redis Cache"
msgstr "Simple Redis Cache"

#. Description of the plugin
#: simple-redis-cache.php
msgid "Redis-only object cache and full-page HTML cache for WordPress."
msgstr ""
"Об'єктний і повносторінковий HTML-кеш для WordPress, що працює виключно "
"через Redis."

#. Author of the plugin
#: simple-redis-cache.php
msgid "Vitalii Kaplia"
msgstr "Vitalii Kaplia"

#. Author URI of the plugin
#: simple-redis-cache.php
msgid "https://kaplia.pro/"
msgstr "https://kaplia.pro/"

#: includes/class-simple-redis-cache-admin.php:49
msgid "Redis Cache"
msgstr "Кеш Redis"

#. translators: %s: URL currently being warmed.
#: includes/class-simple-redis-cache-admin.php:75
#, php-format
msgid "Warming: %s"
msgstr "Прогрів: %s"

#. translators: 1: processed URL count, 2: total URL count.
#: includes/class-simple-redis-cache-admin.php:77
#, php-format
msgid "Processed %1$d of %2$d URLs."
msgstr "Оброблено %1$d з %2$d URL."

#: includes/class-simple-redis-cache-admin.php:90
msgid "Discovering public URLs…"
msgstr "Пошук публічних URL…"

#: includes/class-simple-redis-cache-admin.php:91
#: includes/class-simple-redis-cache-admin.php:458
msgid "Select at least one source to warm."
msgstr "Виберіть принаймні одне джерело для прогріву."

#: includes/class-simple-redis-cache-admin.php:92
msgid "No cacheable public URLs were found for the selected sources."
msgstr ""
"Для вибраних джерел не знайдено публічних URL, придатних для кешування."

#: includes/class-simple-redis-cache-admin.php:95
msgid "Cache warming completed successfully."
msgstr "Прогрів кешу успішно завершено."

#: includes/class-simple-redis-cache-admin.php:96
msgid "Cache warming completed with some URLs not cached."
msgstr "Прогрів кешу завершено, але деякі URL не вдалося закешувати."

#: includes/class-simple-redis-cache-admin.php:97
msgid "Cache warming was stopped."
msgstr "Прогрів кешу зупинено."

#: includes/class-simple-redis-cache-admin.php:98
msgid "Could not prepare cache warming."
msgstr "Не вдалося підготувати прогрів кешу."

#: includes/class-simple-redis-cache-admin.php:99
msgid "Discovering public URLs timed out. Select fewer sources and try again."
msgstr ""
"Пошук публічних URL перевищив час очікування. Виберіть менше джерел і "
"спробуйте ще раз."

#: includes/class-simple-redis-cache-admin.php:100
msgid "The frontend request failed."
msgstr "Не вдалося виконати запит до фронтенду."

#: includes/class-simple-redis-cache-admin.php:101
msgid "The frontend request timed out."
msgstr "Перевищено час очікування відповіді фронтенду."

#: includes/class-simple-redis-cache-admin.php:102
#: includes/class-simple-redis-cache-warmer.php:676
msgid "The frontend response did not contain a page-cache status."
msgstr "Відповідь фронтенду не містить стану кешу сторінок."

#: includes/class-simple-redis-cache-admin.php:103
#: includes/class-simple-redis-cache-warmer.php:259
#: includes/class-simple-redis-cache-warmer.php:271
#: includes/class-simple-redis-cache-warmer.php:282
msgid "The page cache bypassed this URL."
msgstr "Для цього URL кеш сторінок було обійдено."

#: includes/class-simple-redis-cache-admin.php:104
#: includes/class-simple-redis-cache-warmer.php:286
msgid "Redis did not return a cache HIT after the page was rendered."
msgstr "Redis не повернув HIT кешу після генерування сторінки."

#: includes/class-simple-redis-cache-admin.php:105
msgid "Already cached"
msgstr "Уже в кеші"

#: includes/class-simple-redis-cache-admin.php:106
msgid "Warmed now"
msgstr "Щойно прогріто"

#: includes/class-simple-redis-cache-admin.php:107
msgid "Bypassed"
msgstr "Обійдено"

#: includes/class-simple-redis-cache-admin.php:108
msgid "Failed"
msgstr "Не вдалося"

#: includes/class-simple-redis-cache-admin.php:109
#: includes/class-simple-redis-cache-admin.php:401
msgid "Unknown error."
msgstr "Невідома помилка."

#. translators: %d: number of additional issues hidden from the list.
#: includes/class-simple-redis-cache-admin.php:111
#, php-format
msgid "%d more issues not shown."
msgstr "Ще %d проблем не показано."

#: includes/class-simple-redis-cache-admin.php:130
#: includes/class-simple-redis-cache-admin.php:627
#: includes/class-simple-redis-cache-admin.php:1217
msgid "Redis connection"
msgstr "Підключення до Redis"

#: includes/class-simple-redis-cache-admin.php:132
msgid ""
"PhpRedis and one standalone Redis server are supported. Credentials are "
"stored in the WordPress database and in the generated early configuration "
"file required by the drop-ins."
msgstr ""
"Підтримуються PhpRedis і один окремий сервер Redis. Облікові дані "
"зберігаються в базі даних WordPress і у згенерованому файлі ранньої "
"конфігурації, потрібному для роботи drop-in-файлів."

#: includes/class-simple-redis-cache-admin.php:137
msgid "Connection type"
msgstr "Тип підключення"

#: includes/class-simple-redis-cache-admin.php:137
msgid "Unix socket"
msgstr "Unix-сокет"

#: includes/class-simple-redis-cache-admin.php:138
msgid "Host"
msgstr "Хост"

#: includes/class-simple-redis-cache-admin.php:138
msgid "For example: 127.0.0.1. Ignored for Unix sockets."
msgstr "Наприклад: 127.0.0.1. Не використовується для Unix-сокетів."

#: includes/class-simple-redis-cache-admin.php:139
msgid "Port"
msgstr "Порт"

#: includes/class-simple-redis-cache-admin.php:140
msgid "Unix socket path"
msgstr "Шлях до Unix-сокета"

#: includes/class-simple-redis-cache-admin.php:140
msgid ""
"Enter a raw absolute filesystem path, for example: /home/account/.system/"
"redis.sock. Do not add unix://; Host and Port are ignored."
msgstr ""
"Введіть звичайний абсолютний шлях файлової системи, наприклад: /home/"
"account/.system/redis.sock. Не додавайте unix://; поля «Хост» і «Порт» "
"ігноруються."

#: includes/class-simple-redis-cache-admin.php:141
msgid "Database"
msgstr "База даних"

#: includes/class-simple-redis-cache-admin.php:142
msgid "ACL username"
msgstr "Ім'я користувача ACL"

#: includes/class-simple-redis-cache-admin.php:143
msgid "Password"
msgstr "Пароль"

#: includes/class-simple-redis-cache-admin.php:143
msgid ""
"Leave blank to retain the stored password when the option below is checked."
msgstr ""
"Залиште поле порожнім, щоб зберегти поточний пароль, якщо опцію нижче "
"позначено."

#: includes/class-simple-redis-cache-admin.php:144
msgid "Stored password"
msgstr "Збережений пароль"

#: includes/class-simple-redis-cache-admin.php:145
msgid "Connect timeout"
msgstr "Час очікування підключення"

#: includes/class-simple-redis-cache-admin.php:145
#: includes/class-simple-redis-cache-admin.php:146
#: includes/class-simple-redis-cache-admin.php:175
msgid "Seconds."
msgstr "Секунди."

#: includes/class-simple-redis-cache-admin.php:146
msgid "Read timeout"
msgstr "Час очікування читання"

#: includes/class-simple-redis-cache-admin.php:147
msgid "Retry interval"
msgstr "Інтервал повторної спроби"

#: includes/class-simple-redis-cache-admin.php:147
msgid "Milliseconds."
msgstr "Мілісекунди."

#: includes/class-simple-redis-cache-admin.php:148
msgid "Persistent connection"
msgstr "Постійне підключення"

#: includes/class-simple-redis-cache-admin.php:152
#: includes/class-simple-redis-cache-admin.php:1218
msgid "Object cache"
msgstr "Об'єктний кеш"

#: includes/class-simple-redis-cache-admin.php:154
msgid ""
"Stores WordPress Object Cache API values in Redis through object-cache.php."
msgstr ""
"Зберігає значення WordPress Object Cache API у Redis через object-cache.php."

#: includes/class-simple-redis-cache-admin.php:159
msgid "Enable object cache"
msgstr "Увімкнути об'єктний кеш"

#: includes/class-simple-redis-cache-admin.php:160
msgid "Maximum TTL"
msgstr "Максимальний TTL"

#: includes/class-simple-redis-cache-admin.php:160
msgid ""
"Seconds. A caller-provided shorter TTL remains unchanged; zero or a longer "
"TTL is capped here."
msgstr ""
"Секунди. Коротший TTL, переданий викликом, не змінюється; нульовий або "
"довший TTL обмежується цим значенням."

#: includes/class-simple-redis-cache-admin.php:161
msgid "Read object cache in wp-admin"
msgstr "Читати об'єктний кеш у wp-admin"

#: includes/class-simple-redis-cache-admin.php:161
msgid ""
"When disabled, normal wp-admin reads bypass Redis. Writes and invalidations "
"still reach Redis; transients remain readable from Redis when no database "
"mirror is enabled."
msgstr ""
"Якщо вимкнено, звичайні операції читання у wp-admin оминають Redis. Записи "
"та інвалідації й надалі потрапляють до Redis; коли дзеркалювання в базу "
"даних вимкнено, транзієнти залишаються доступними для читання з Redis."

#: includes/class-simple-redis-cache-admin.php:162
msgid "Database transient mirror"
msgstr "Дзеркалювання транзієнтів у базі даних"

#: includes/class-simple-redis-cache-admin.php:162
msgid ""
"Write transient and site-transient values to both Redis and the database, "
"and read the database on a Redis miss."
msgstr ""
"Записувати значення transient і site-transient одночасно до Redis та бази "
"даних, а за промаху Redis читати їх із бази даних."

#: includes/class-simple-redis-cache-admin.php:163
msgid "Non-persistent groups"
msgstr "Непостійні групи"

#: includes/class-simple-redis-cache-admin.php:163
msgid "One exact WordPress cache group per line."
msgstr "По одній точній назві групи кешу WordPress у кожному рядку."

#: includes/class-simple-redis-cache-admin.php:167
#: includes/class-simple-redis-cache-admin.php:1219
msgid "HTML page cache"
msgstr "Кеш HTML-сторінок"

#: includes/class-simple-redis-cache-admin.php:169
msgid ""
"Stores eligible public HTML responses in Redis through advanced-cache.php. "
"No cached pages are written to disk."
msgstr ""
"Зберігає придатні публічні HTML-відповіді у Redis через advanced-cache.php. "
"Кешовані сторінки не записуються на диск."

#: includes/class-simple-redis-cache-admin.php:174
msgid "Enable page cache"
msgstr "Увімкнути кеш сторінок"

#: includes/class-simple-redis-cache-admin.php:174
msgid ""
"The plugin attempts to add define( 'WP_CACHE', true ); to wp-config.php when "
"needed. If automatic enabling fails, set WP_CACHE to true manually and "
"verify the Status tab."
msgstr ""
"За потреби плагін намагається додати define( 'WP_CACHE', true ); до wp-"
"config.php. Якщо автоматичне ввімкнення не вдалося, вручну встановіть для "
"WP_CACHE значення true й перевірте вкладку «Стан»."

#: includes/class-simple-redis-cache-admin.php:175
msgid "Page TTL"
msgstr "TTL сторінки"

#: includes/class-simple-redis-cache-admin.php:176
msgid "CDN cache lifetime"
msgstr "Час життя в CDN"

#: includes/class-simple-redis-cache-admin.php:176
msgid ""
"Seconds a CDN or reverse proxy may keep a cache hit, sent as Cache-Control: "
"public, max-age=0, s-maxage=N. Browsers still revalidate every time. Zero "
"disables the header, which is what shared caches see today. Enable this only "
"if you are willing to purge the CDN when content changes, because the CDN "
"does not know about page invalidation."
msgstr ""
"Скільки секунд CDN або зворотний проксі може тримати попадання кешу; "
"надсилається як Cache-Control: public, max-age=0, s-maxage=N. Браузери "
"щоразу перевіряють заново. Нуль вимикає заголовок — саме це shared-кеші "
"бачать зараз. Вмикайте лише тоді, коли готові чистити CDN після зміни "
"контенту, бо про інвалідацію сторінки він не дізнається."

#: includes/class-simple-redis-cache-admin.php:177
msgid "Clear a page's cache when it is updated"
msgstr "Очищати кеш сторінки при її оновленні"

#: includes/class-simple-redis-cache-admin.php:177
msgid ""
"Invalidates only the updated post, page or custom post type and all "
"translations detected through WPML or Polylang. Unrelated home, archive and "
"other derived pages are not cleared."
msgstr ""
"Інвалідує лише оновлений запис, сторінку або користувацький тип запису та "
"всі переклади, знайдені через WPML або Polylang. Головна, архіви та інші "
"похідні сторінки, які не є безпосередньо оновленою сторінкою, не очищуються."

#: includes/class-simple-redis-cache-admin.php:178
msgid "Clear related taxonomy archives when a post is updated"
msgstr "Очищати кеш пов'язаних архівів таксономій при оновленні запису"

#: includes/class-simple-redis-cache-admin.php:178
msgid ""
"Invalidates archives of current, previous and new assigned terms in public "
"standard and custom taxonomies, including hierarchical parents and terms "
"assigned to WPML or Polylang translations. Unrelated taxonomy archives "
"remain cached."
msgstr ""
"Інвалідує архіви поточних, попередніх і нових призначених термів у публічних "
"стандартних і користувацьких таксономіях, включно з батьківськими термами "
"ієрархії та термами, призначеними перекладам WPML або Polylang. Непов'язані "
"архіви таксономій залишаються в кеші."

#: includes/class-simple-redis-cache-admin.php:179
msgid "Cache logged-in users"
msgstr "Кешувати сторінки авторизованих користувачів"

#: includes/class-simple-redis-cache-admin.php:179
msgid ""
"Disabled is safest. Logged-in variants are isolated by session when enabled."
msgstr ""
"Найбезпечніше залишити вимкненим. Після ввімкнення варіанти для "
"авторизованих користувачів ізолюються за сесією."

#: includes/class-simple-redis-cache-admin.php:180
msgid "Cache home page"
msgstr "Кешувати головну сторінку"

#: includes/class-simple-redis-cache-admin.php:181
msgid "Cache posts, pages and CPTs"
msgstr "Кешувати дописи, сторінки та власні типи записів"

#: includes/class-simple-redis-cache-admin.php:182
msgid "Cache archives"
msgstr "Кешувати архіви"

#: includes/class-simple-redis-cache-admin.php:183
msgid "Cache search results"
msgstr "Кешувати результати пошуку"

#: includes/class-simple-redis-cache-admin.php:184
msgid "Cache 404 responses"
msgstr "Кешувати відповіді 404"

#: includes/class-simple-redis-cache-admin.php:185
msgid "Cache query strings"
msgstr "Кешувати рядки запиту"

#: includes/class-simple-redis-cache-admin.php:185
msgid ""
"Non-ignored query parameters normally bypass page cache unless this is "
"enabled; supported search parameters are a limited exception. Built-in "
"unsafe parameters always bypass."
msgstr ""
"Запити з параметрами, які не ігноруються, зазвичай оминають кеш сторінок, "
"якщо цю опцію не ввімкнено; підтримувані параметри пошуку є обмеженим "
"винятком. Вбудовані небезпечні параметри завжди оминають кеш."

#: includes/class-simple-redis-cache-admin.php:186
msgid "Ignored query parameters"
msgstr "Ігноровані параметри запиту"

#: includes/class-simple-redis-cache-admin.php:186
msgid ""
"One exact name or wildcard pattern per line; * and ? are supported. Matching "
"non-sensitive parameters are removed from the cache key; built-in unsafe "
"names cannot be ignored."
msgstr ""
"По одному точному імені або шаблону в рядку; підтримуються * і ?. Відповідні "
"безпечні параметри вилучаються з ключа кешу; вбудовані небезпечні імена "
"ігнорувати не можна."

#: includes/class-simple-redis-cache-admin.php:187
msgid "Excluded paths"
msgstr "Виключені шляхи"

#: includes/class-simple-redis-cache-admin.php:187
msgid "One path pattern per line; * and ? are supported."
msgstr "Один шаблон шляху на рядок; підтримуються * і ?."

#: includes/class-simple-redis-cache-admin.php:188
msgid "Excluded request cookies"
msgstr "Виключені cookie запиту"

#: includes/class-simple-redis-cache-admin.php:188
msgid ""
"Matching cookies normally bypass page cache. Vary-cookie entries and the "
"default WordPress auth prefixes when logged-in caching is enabled use "
"isolated variants instead. Use one exact name, wildcard pattern, or "
"conventional prefix ending in _ per line."
msgstr ""
"Cookie, що відповідають правилам, зазвичай оминають кеш сторінок. Натомість "
"cookie зі списку варіацій і стандартні префікси cookie автентифікації "
"WordPress, коли кеш авторизованих користувачів увімкнено, використовують "
"ізольовані варіанти. У кожному рядку вкажіть точне ім'я, шаблон або "
"звичайний префікс, що закінчується символом _."

#: includes/class-simple-redis-cache-admin.php:189
msgid "Excluded user agents"
msgstr "Виключені User-Agent"

#: includes/class-simple-redis-cache-admin.php:189
msgid "One case-insensitive substring or wildcard pattern per line."
msgstr ""
"Один нечутливий до регістру підрядок або шаблон із символами підстановки на "
"рядок."

#: includes/class-simple-redis-cache-admin.php:190
msgid "Cookies that vary the cache key"
msgstr "Cookie, що змінюють ключ кешу"

#: includes/class-simple-redis-cache-admin.php:190
msgid ""
"One cookie name per line. Useful for language cookies that safely select a "
"page variant."
msgstr ""
"По одній назві cookie в кожному рядку. Корисно для мовних cookie, які "
"безпечно обирають варіант сторінки."

#: includes/class-simple-redis-cache-admin.php:191
msgid "Allowed response Set-Cookie names"
msgstr "Дозволені назви Set-Cookie у відповіді"

#: includes/class-simple-redis-cache-admin.php:191
msgid ""
"Responses setting only these cookie names may be stored; Set-Cookie headers "
"are never replayed from cache."
msgstr ""
"Можна зберігати відповіді, які встановлюють лише ці cookie; заголовки Set-"
"Cookie ніколи не відтворюються з кешу."

#: includes/class-simple-redis-cache-admin.php:192
msgid "Debug response header"
msgstr "Діагностичний заголовок відповіді"

#: includes/class-simple-redis-cache-admin.php:192
msgid "Send X-Simple-Redis-Cache with HIT, MISS or BYPASS status."
msgstr "Надсилати X-Simple-Redis-Cache зі статусом HIT, MISS або BYPASS."

#: includes/class-simple-redis-cache-admin.php:196
#: includes/class-simple-redis-cache-admin.php:1220
msgid "Cloudflare cache"
msgstr "Кеш Cloudflare"

#: includes/class-simple-redis-cache-admin.php:198
msgid ""
"Clears the Cloudflare edge cache alongside this site's own caches. Clearing "
"the origin without clearing the edge leaves visitors on the previous page "
"until the CDN lifetime expires."
msgstr ""
"Очищає кеш Cloudflare разом із власними кешами сайту. Якщо очистити origin і "
"не очистити edge, відвідувачі бачитимуть попередню сторінку до кінця часу "
"життя в CDN."

#: includes/class-simple-redis-cache-admin.php:199
msgid ""
"Create a scoped API token in Cloudflare with the Zone / Cache Purge "
"permission limited to this zone. An account-wide Global API Key is not used "
"and is not required."
msgstr ""
"Створіть у Cloudflare обмежений API-токен із правом Zone / Cache Purge саме "
"для цієї зони. Загальноакаунтний Global API Key не використовується й не "
"потрібен."

#: includes/class-simple-redis-cache-admin.php:204
#: includes/class-simple-redis-cache-admin.php:682
msgid "Zone ID"
msgstr "Zone ID"

#: includes/class-simple-redis-cache-admin.php:204
msgid "The 32-character zone ID from the Cloudflare dashboard overview page."
msgstr ""
"32-символьний ідентифікатор зони зі сторінки огляду в панелі Cloudflare."

#: includes/class-simple-redis-cache-admin.php:205
msgid "API token"
msgstr "API-токен"

#: includes/class-simple-redis-cache-admin.php:205
msgid ""
"Leave blank to retain the stored token when the option below is checked."
msgstr ""
"Залиште поле порожнім, щоб зберегти поточний токен, якщо опцію нижче "
"позначено."

#: includes/class-simple-redis-cache-admin.php:206
msgid "Stored API token"
msgstr "Збережений API-токен"

#: includes/class-simple-redis-cache-admin.php:207
msgid "Clear Cloudflare with Clear all cache"
msgstr "Очищати Cloudflare разом з «Очистити весь кеш»"

#: includes/class-simple-redis-cache-admin.php:207
msgid ""
"Purge the whole Cloudflare zone whenever the Clear all cache action runs."
msgstr ""
"Очищати всю зону Cloudflare щоразу, коли виконується дія «Очистити весь кеш»."

#: includes/class-simple-redis-cache-admin.php:208
msgid "Clear Cloudflare with Clear page cache"
msgstr "Очищати Cloudflare разом з «Очистити кеш HTML-сторінок»"

#: includes/class-simple-redis-cache-admin.php:208
msgid ""
"Purge the whole Cloudflare zone whenever the Clear page cache action runs."
msgstr ""
"Очищати всю зону Cloudflare щоразу, коли виконується дія «Очистити кеш HTML-"
"сторінок»."

#: includes/class-simple-redis-cache-admin.php:209
msgid "Clear Cloudflare when content is updated"
msgstr "Очищати Cloudflare при оновленні контенту"

#: includes/class-simple-redis-cache-admin.php:209
msgid ""
"Purge the exact URLs this plugin already invalidates on the HTML Page Cache "
"tab, so it requires those options to be enabled. Only the updated entries "
"and the first page of related term archives are purged; deeper pagination "
"and generic views are not, because Cloudflare purges exact URLs."
msgstr ""
"Очищає саме ті адреси, які плагін уже інвалідує згідно з налаштуваннями "
"вкладки «Кеш HTML-сторінок», тому потребує, щоб ті опції були ввімкнені. "
"Очищаються лише оновлені записи та перша сторінка пов’язаних архівів; глибша "
"пагінація й загальні подання — ні, бо Cloudflare очищає точні адреси."

#: includes/class-simple-redis-cache-admin.php:232
msgid ""
"The settings were not saved because the submitted section was invalid. "
"Please reload the page and try again."
msgstr ""
"Налаштування не збережено, оскільки надісланий розділ недійсний. "
"Перезавантажте сторінку та повторіть спробу."

#: includes/class-simple-redis-cache-admin.php:268
msgid ""
"Redis-only object and full-page cache for a single WordPress site. Cache "
"entries use a non-empty WP_CACHE_KEY_SALT when defined, or a generated per-"
"site fallback prefix."
msgstr ""
"Об'єктний і повносторінковий кеш виключно через Redis для одного сайту "
"WordPress. Записи кешу використовують непорожній WP_CACHE_KEY_SALT, якщо "
"його визначено, або згенерований резервний префікс сайту."

#: includes/class-simple-redis-cache-admin.php:319
msgid "Enabled"
msgstr "Увімкнено"

#: includes/class-simple-redis-cache-admin.php:323
