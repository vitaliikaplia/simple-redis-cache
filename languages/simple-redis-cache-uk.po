msgstr "Шаблон drop-in Simple Redis Cache недоступний для читання: %s"

#: includes/class-simple-redis-cache-dropins.php:74
msgid "The Simple Redis Cache drop-in template is invalid."
msgstr "Шаблон drop-in Simple Redis Cache недійсний."

#: includes/class-simple-redis-cache-dropins.php:83
