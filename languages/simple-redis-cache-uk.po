#. Plugin Name of the plugin
#: simple-redis-cache.php includes/class-simple-redis-cache-admin.php:37
#: includes/class-simple-redis-cache-admin.php:228
msgid "Simple Redis Cache"
msgstr "Simple Redis Cache"

#. Description of the plugin
#: simple-redis-cache.php
msgid "Redis-only object cache and full-page HTML cache for WordPress."
msgstr "Об'єктний і повносторінковий HTML-кеш для WordPress, що працює виключно через Redis."

#. Author of the plugin
#: simple-redis-cache.php
msgid "Vitalii Kaplia"
msgstr "Vitalii Kaplia"

#. Author URI of the plugin
#: simple-redis-cache.php
msgid "https://kaplia.pro/"
msgstr "https://kaplia.pro/"

#: includes/class-simple-redis-cache-admin.php:38
msgid "Redis Cache"
msgstr "Кеш Redis"

#. translators: %s: URL currently being warmed.
#: includes/class-simple-redis-cache-admin.php:64
#, php-format
msgid "Warming: %s"
msgstr "Прогрів: %s"

#. translators: 1: processed URL count, 2: total URL count.
#: includes/class-simple-redis-cache-admin.php:66
#, php-format
msgid "Processed %1$d of %2$d URLs."
msgstr "Оброблено %1$d з %2$d URL."

#: includes/class-simple-redis-cache-admin.php:77
msgid "Discovering public URLs…"
msgstr "Пошук публічних URL…"

#: includes/class-simple-redis-cache-admin.php:78
#: includes/class-simple-redis-cache-admin.php:373
msgid "Select at least one source to warm."
msgstr "Виберіть принаймні одне джерело для прогріву."

#: includes/class-simple-redis-cache-admin.php:79
msgid "No cacheable public URLs were found for the selected sources."
msgstr "Для вибраних джерел не знайдено публічних URL, придатних для кешування."

#: includes/class-simple-redis-cache-admin.php:82
msgid "Cache warming completed successfully."
msgstr "Прогрів кешу успішно завершено."

#: includes/class-simple-redis-cache-admin.php:83
msgid "Cache warming completed with some URLs not cached."
msgstr "Прогрів кешу завершено, але деякі URL не вдалося закешувати."

#: includes/class-simple-redis-cache-admin.php:84
msgid "Cache warming was stopped."
msgstr "Прогрів кешу зупинено."

#: includes/class-simple-redis-cache-admin.php:85
msgid "Could not prepare cache warming."
msgstr "Не вдалося підготувати прогрів кешу."

#: includes/class-simple-redis-cache-admin.php:86
msgid "The frontend request failed."
msgstr "Не вдалося виконати запит до фронтенду."

#: includes/class-simple-redis-cache-admin.php:87
#: includes/class-simple-redis-cache-warmer.php:524
msgid "The frontend response did not contain a page-cache status."
msgstr "Відповідь фронтенду не містить стану кешу сторінок."

#: includes/class-simple-redis-cache-admin.php:88
#: includes/class-simple-redis-cache-warmer.php:189
#: includes/class-simple-redis-cache-warmer.php:201
#: includes/class-simple-redis-cache-warmer.php:212
msgid "The page cache bypassed this URL."
msgstr "Для цього URL кеш сторінок було обійдено."

#: includes/class-simple-redis-cache-admin.php:89
#: includes/class-simple-redis-cache-warmer.php:216
msgid "Redis did not return a cache HIT after the page was rendered."
msgstr "Redis не повернув HIT кешу після генерування сторінки."

#: includes/class-simple-redis-cache-admin.php:90
msgid "Already cached"
msgstr "Уже в кеші"

#: includes/class-simple-redis-cache-admin.php:91
msgid "Warmed now"
msgstr "Щойно прогріто"

#: includes/class-simple-redis-cache-admin.php:92
msgid "Bypassed"
msgstr "Обійдено"

#: includes/class-simple-redis-cache-admin.php:93
msgid "Failed"
msgstr "Не вдалося"

#: includes/class-simple-redis-cache-admin.php:94
#: includes/class-simple-redis-cache-admin.php:323
msgid "Unknown error."
msgstr "Невідома помилка."

#: includes/class-simple-redis-cache-admin.php:113
#: includes/class-simple-redis-cache-admin.php:517
#: includes/class-simple-redis-cache-admin.php:717
msgid "Redis connection"
msgstr "Підключення до Redis"

#: includes/class-simple-redis-cache-admin.php:115
msgid "PhpRedis and one standalone Redis server are supported. Credentials are stored in the WordPress database."
msgstr "Підтримуються PhpRedis і один окремий сервер Redis. Облікові дані зберігаються в базі даних WordPress."

#: includes/class-simple-redis-cache-admin.php:120
msgid "Connection type"
msgstr "Тип підключення"

#: includes/class-simple-redis-cache-admin.php:120
msgid "Unix socket"
msgstr "Unix-сокет"

#: includes/class-simple-redis-cache-admin.php:121
msgid "Host"
msgstr "Хост"

#: includes/class-simple-redis-cache-admin.php:121
msgid "For example: 127.0.0.1. Ignored for Unix sockets."
msgstr "Наприклад: 127.0.0.1. Не використовується для Unix-сокетів."

#: includes/class-simple-redis-cache-admin.php:122
msgid "Port"
msgstr "Порт"

#: includes/class-simple-redis-cache-admin.php:123
msgid "Unix socket path"
msgstr "Шлях до Unix-сокета"

#: includes/class-simple-redis-cache-admin.php:124
msgid "Database"
msgstr "База даних"

#: includes/class-simple-redis-cache-admin.php:125
msgid "ACL username"
msgstr "Ім'я користувача ACL"

#: includes/class-simple-redis-cache-admin.php:126
msgid "Password"
msgstr "Пароль"

#: includes/class-simple-redis-cache-admin.php:126
msgid "Leave blank to retain the stored password when the option below is checked."
msgstr "Залиште поле порожнім, щоб зберегти поточний пароль, якщо опцію нижче позначено."

#: includes/class-simple-redis-cache-admin.php:127
msgid "Stored password"
msgstr "Збережений пароль"

#: includes/class-simple-redis-cache-admin.php:128
msgid "Connect timeout"
msgstr "Час очікування підключення"

#: includes/class-simple-redis-cache-admin.php:128
#: includes/class-simple-redis-cache-admin.php:129
#: includes/class-simple-redis-cache-admin.php:158
msgid "Seconds."
msgstr "Секунди."

#: includes/class-simple-redis-cache-admin.php:129
msgid "Read timeout"
msgstr "Час очікування читання"

#: includes/class-simple-redis-cache-admin.php:130
msgid "Retry interval"
msgstr "Інтервал повторної спроби"

#: includes/class-simple-redis-cache-admin.php:130
msgid "Milliseconds."
msgstr "Мілісекунди."

#: includes/class-simple-redis-cache-admin.php:131
msgid "Persistent connection"
msgstr "Постійне підключення"

#: includes/class-simple-redis-cache-admin.php:135
#: includes/class-simple-redis-cache-admin.php:718
msgid "Object cache"
msgstr "Об'єктний кеш"

#: includes/class-simple-redis-cache-admin.php:137
msgid "Stores WordPress Object Cache API values in Redis through object-cache.php."
msgstr "Зберігає значення WordPress Object Cache API у Redis через object-cache.php."

#: includes/class-simple-redis-cache-admin.php:142
msgid "Enable object cache"
msgstr "Увімкнути об'єктний кеш"

#: includes/class-simple-redis-cache-admin.php:143
msgid "Maximum TTL"
msgstr "Максимальний TTL"

#: includes/class-simple-redis-cache-admin.php:143
msgid "Seconds. A caller-provided shorter TTL remains unchanged; zero or a longer TTL is capped here."
msgstr "Секунди. Коротший TTL, переданий викликом, не змінюється; нульовий або довший TTL обмежується цим значенням."

#: includes/class-simple-redis-cache-admin.php:144
msgid "Read object cache in wp-admin"
msgstr "Читати об'єктний кеш у wp-admin"

#: includes/class-simple-redis-cache-admin.php:144
msgid "When disabled, normal wp-admin reads bypass Redis. Writes and invalidations still reach Redis; transients remain readable from Redis when no database mirror is enabled."
msgstr "Якщо вимкнено, звичайні операції читання у wp-admin оминають Redis. Записи та інвалідації й надалі потрапляють до Redis; коли дзеркалювання в базу даних вимкнено, транзієнти залишаються доступними для читання з Redis."

#: includes/class-simple-redis-cache-admin.php:145
msgid "Database transient mirror"
msgstr "Дзеркалювання транзієнтів у базі даних"

#: includes/class-simple-redis-cache-admin.php:145
msgid "Write transient and site-transient values to both Redis and the database, and read the database on a Redis miss."
msgstr "Записувати значення transient і site-transient одночасно до Redis та бази даних, а за промаху Redis читати їх із бази даних."

#: includes/class-simple-redis-cache-admin.php:146
msgid "Non-persistent groups"
msgstr "Непостійні групи"

#: includes/class-simple-redis-cache-admin.php:146
msgid "One exact WordPress cache group per line."
msgstr "По одній точній назві групи кешу WordPress у кожному рядку."

#: includes/class-simple-redis-cache-admin.php:150
#: includes/class-simple-redis-cache-admin.php:719
msgid "HTML page cache"
msgstr "Кеш HTML-сторінок"

#: includes/class-simple-redis-cache-admin.php:152
msgid "Stores eligible public HTML responses in Redis through advanced-cache.php. No cached pages are written to disk."
msgstr "Зберігає придатні публічні HTML-відповіді у Redis через advanced-cache.php. Кешовані сторінки не записуються на диск."

#: includes/class-simple-redis-cache-admin.php:157
msgid "Enable page cache"
msgstr "Увімкнути кеш сторінок"

#: includes/class-simple-redis-cache-admin.php:157
msgid "Enabling this option also adds define( 'WP_CACHE', true ); to wp-config.php when needed."
msgstr "Якщо потрібно, увімкнення цієї опції також додає define( 'WP_CACHE', true ); до wp-config.php."

#: includes/class-simple-redis-cache-admin.php:158
msgid "Page TTL"
msgstr "TTL сторінки"

#: includes/class-simple-redis-cache-admin.php:159
msgid "Cache logged-in users"
msgstr "Кешувати сторінки авторизованих користувачів"

#: includes/class-simple-redis-cache-admin.php:159
msgid "Disabled is safest. Logged-in variants are isolated by session when enabled."
msgstr "Найбезпечніше залишити вимкненим. Після ввімкнення варіанти для авторизованих користувачів ізолюються за сесією."

#: includes/class-simple-redis-cache-admin.php:160
msgid "Cache home page"
msgstr "Кешувати головну сторінку"

#: includes/class-simple-redis-cache-admin.php:161
msgid "Cache posts, pages and CPTs"
msgstr "Кешувати дописи, сторінки та власні типи записів"

#: includes/class-simple-redis-cache-admin.php:162
msgid "Cache archives"
msgstr "Кешувати архіви"

#: includes/class-simple-redis-cache-admin.php:163
msgid "Cache search results"
msgstr "Кешувати результати пошуку"

#: includes/class-simple-redis-cache-admin.php:164
msgid "Cache 404 responses"
msgstr "Кешувати відповіді 404"

#: includes/class-simple-redis-cache-admin.php:165
msgid "Cache query strings"
msgstr "Кешувати рядки запиту"

#: includes/class-simple-redis-cache-admin.php:165
msgid "Unknown query parameters bypass page cache unless this is enabled."
msgstr "Якщо цю опцію не ввімкнено, невідомі параметри запиту оминають кеш сторінок."

#: includes/class-simple-redis-cache-admin.php:166
msgid "Ignored query parameters"
msgstr "Ігноровані параметри запиту"

#: includes/class-simple-redis-cache-admin.php:166
msgid "One name or prefix ending in * per line. These parameters are removed from the cache key."
msgstr "По одній назві або префіксу із * наприкінці в кожному рядку. Ці параметри вилучаються з ключа кешу."

#: includes/class-simple-redis-cache-admin.php:167
msgid "Excluded paths"
msgstr "Виключені шляхи"

#: includes/class-simple-redis-cache-admin.php:167
msgid "One path pattern per line; * is supported."
msgstr "По одному шаблону шляху в кожному рядку; підтримується *."

#: includes/class-simple-redis-cache-admin.php:168
msgid "Excluded request cookies"
msgstr "Виключені cookie запиту"

#: includes/class-simple-redis-cache-admin.php:168
msgid "A matching cookie bypasses page cache. One name or prefix per line."
msgstr "Запит із відповідним cookie оминає кеш сторінок. По одній назві або префіксу в кожному рядку."

#: includes/class-simple-redis-cache-admin.php:169
msgid "Excluded user agents"
msgstr "Виключені User-Agent"

#: includes/class-simple-redis-cache-admin.php:169
msgid "One substring per line."
msgstr "По одному підрядку в кожному рядку."

#: includes/class-simple-redis-cache-admin.php:170
msgid "Cookies that vary the cache key"
msgstr "Cookie, що змінюють ключ кешу"

#: includes/class-simple-redis-cache-admin.php:170
msgid "One cookie name per line. Useful for language cookies that safely select a page variant."
msgstr "По одній назві cookie в кожному рядку. Корисно для мовних cookie, які безпечно обирають варіант сторінки."

#: includes/class-simple-redis-cache-admin.php:171
msgid "Allowed response Set-Cookie names"
msgstr "Дозволені назви Set-Cookie у відповіді"

#: includes/class-simple-redis-cache-admin.php:171
msgid "Responses setting only these cookie names may be stored; Set-Cookie headers are never replayed from cache."
msgstr "Можна зберігати відповіді, які встановлюють лише ці cookie; заголовки Set-Cookie ніколи не відтворюються з кешу."

#: includes/class-simple-redis-cache-admin.php:172
msgid "Debug response header"
msgstr "Діагностичний заголовок відповіді"

#: includes/class-simple-redis-cache-admin.php:172
msgid "Send X-Simple-Redis-Cache with HIT, MISS or BYPASS status."
msgstr "Надсилати X-Simple-Redis-Cache зі статусом HIT, MISS або BYPASS."

#: includes/class-simple-redis-cache-admin.php:195
msgid "The settings were not saved because the submitted section was invalid. Please reload the page and try again."
msgstr "Налаштування не збережено, оскільки надісланий розділ недійсний. Перезавантажте сторінку та повторіть спробу."

#: includes/class-simple-redis-cache-admin.php:229
msgid "Redis-only object and full-page cache for a single WordPress site. Cache entries are isolated by WP_CACHE_KEY_SALT when it is defined."
msgstr "Об'єктний і повносторінковий кеш виключно на Redis для одного сайту WordPress. Якщо визначено WP_CACHE_KEY_SALT, записи кешу ізолюються за його значенням."

#: includes/class-simple-redis-cache-admin.php:266
msgid "Enabled"
msgstr "Увімкнено"

#: includes/class-simple-redis-cache-admin.php:270
msgid "Keep the currently stored password when the password field is blank"
msgstr "Зберегти поточний пароль, якщо поле пароля порожнє"

#: includes/class-simple-redis-cache-admin.php:272
msgid "A password is currently stored."
msgstr "Пароль уже збережено."

#. translators: %s: Redis version.
#: includes/class-simple-redis-cache-admin.php:314
#, php-format
msgid "Redis connection succeeded (Redis %s)."
msgstr "Підключення до Redis успішне (Redis %s)."

#. translators: %s: Redis version.
#: includes/class-simple-redis-cache-admin.php:315
msgid "Redis connection succeeded."
msgstr "Підключення до Redis успішне."

#. translators: %s: Redis error.
#: includes/class-simple-redis-cache-admin.php:322
#, php-format
msgid "Redis connection failed: %s"
msgstr "Не вдалося підключитися до Redis: %s"

#: includes/class-simple-redis-cache-admin.php:334
msgid "You are not allowed to clear this cache."
msgstr "Вам не дозволено очищувати цей кеш."

#: includes/class-simple-redis-cache-admin.php:339
#: includes/class-simple-redis-cache-purger.php:22
msgid "Invalid cache purge scope."
msgstr "Недійсна область очищення кешу."

#: includes/class-simple-redis-cache-admin.php:349
msgid "All Redis caches were cleared."
msgstr "Усі кеші Redis очищено."

#: includes/class-simple-redis-cache-admin.php:350
msgid "Object cache was cleared."
msgstr "Об'єктний кеш очищено."

#: includes/class-simple-redis-cache-admin.php:351
msgid "HTML page cache was cleared."
msgstr "Кеш HTML-сторінок очищено."

#: includes/class-simple-redis-cache-admin.php:399
msgid "The cache-warming URL could not be verified."
msgstr "Не вдалося перевірити URL для прогріву кешу."

#: includes/class-simple-redis-cache-admin.php:413
#: includes/class-simple-redis-cache-admin.php:415
msgid "Caching"
msgstr "Кешування"

#: includes/class-simple-redis-cache-admin.php:419
msgid "Clear all"
msgstr "Очистити все"

#: includes/class-simple-redis-cache-admin.php:420
msgid "Clear HTML page cache"
msgstr "Очистити кеш HTML-сторінок"

#: includes/class-simple-redis-cache-admin.php:421
#: includes/class-simple-redis-cache-admin.php:533
msgid "Clear object cache"
msgstr "Очистити об'єктний кеш"

#: includes/class-simple-redis-cache-admin.php:422
#: includes/class-simple-redis-cache-admin.php:612
msgid "Warm cache"
msgstr "Прогріти кеш"

#: includes/class-simple-redis-cache-admin.php:423
#: includes/class-simple-redis-cache-admin.php:428
msgid "Settings"
msgstr "Налаштування"

#: includes/class-simple-redis-cache-admin.php:466
msgid "Simple Redis Cache requires the PhpRedis extension; caching will fail open until it is installed."
msgstr "Simple Redis Cache потребує розширення PhpRedis; доки його не встановлено, помилки кешування не блокуватимуть звичайні HTTP-запити."

#: includes/class-simple-redis-cache-admin.php:473
msgctxt "cache type in an admin notice"
msgid "Object cache"
msgstr "Об'єктний кеш"

#: includes/class-simple-redis-cache-admin.php:474
msgctxt "cache type in an admin notice"
msgid "HTML page cache"
msgstr "Кеш HTML-сторінок"

#. translators: %s: localized cache type.
#: includes/class-simple-redis-cache-admin.php:479
#, php-format
msgid "%s cannot start because another plugin owns its WordPress drop-in."
msgstr "%s не може запуститися, оскільки відповідний drop-in WordPress належить іншому плагіну."

#. translators: %s: localized cache type.
#: includes/class-simple-redis-cache-admin.php:488
#, php-format
msgid "%s is enabled in settings, but its WordPress drop-in is not installed."
msgstr "%s увімкнено в налаштуваннях, але відповідний drop-in WordPress не встановлено."

#: includes/class-simple-redis-cache-admin.php:498
msgid "HTML page cache is enabled, but WP_CACHE is not true in the current request. Check wp-config.php; a newly added definition takes effect on the next request."
msgstr "Кеш HTML-сторінок увімкнено, але WP_CACHE не має значення true в поточному запиті. Перевірте wp-config.php; щойно додане визначення набуде чинності в наступному запиті."

#: includes/class-simple-redis-cache-admin.php:509
msgid "Installed by Simple Redis Cache"
msgstr "Встановлено плагіном Simple Redis Cache"

#: includes/class-simple-redis-cache-admin.php:510
msgid "Foreign drop-in (not modified)"
msgstr "Сторонній drop-in (не змінено)"

#: includes/class-simple-redis-cache-admin.php:511
msgid "Not installed"
msgstr "Не встановлено"

#: includes/class-simple-redis-cache-admin.php:514
msgid "Status and diagnostics"
msgstr "Стан і діагностика"

#: includes/class-simple-redis-cache-admin.php:516
msgid "PhpRedis"
msgstr "PhpRedis"

#: includes/class-simple-redis-cache-admin.php:516
msgid "Available"
msgstr "Доступне"

#: includes/class-simple-redis-cache-admin.php:516
msgid "Missing"
msgstr "Відсутнє"

#: includes/class-simple-redis-cache-admin.php:517
msgid "Connected"
msgstr "Підключено"

#: includes/class-simple-redis-cache-admin.php:517
msgid "Unavailable"
msgstr "Недоступно"

#: includes/class-simple-redis-cache-admin.php:518
msgid "Object drop-in"
msgstr "Drop-in об'єктного кешу"

#: includes/class-simple-redis-cache-admin.php:519
msgid "Page drop-in"
msgstr "Drop-in кешу сторінок"

#: includes/class-simple-redis-cache-admin.php:520
msgid "WP_CACHE"
msgstr "WP_CACHE"

#: includes/class-simple-redis-cache-admin.php:520
msgid "true"
msgstr "true"

#: includes/class-simple-redis-cache-admin.php:520
msgid "not true"
msgstr "не дорівнює true"

#: includes/class-simple-redis-cache-admin.php:521
msgid "Generated early config"
msgstr "Згенерована рання конфігурація"

#: includes/class-simple-redis-cache-admin.php:521
msgid "readable"
msgstr "доступна для читання"

#: includes/class-simple-redis-cache-admin.php:521
msgid "missing or unreadable"
msgstr "відсутня або недоступна для читання"

#: includes/class-simple-redis-cache-admin.php:522
msgid "Redis key prefix"
msgstr "Префікс ключів Redis"

#: includes/class-simple-redis-cache-admin.php:522
msgid "Define WP_CACHE_KEY_SALT in wp-config.php to control the leading prefix for every key."
msgstr "Визначте WP_CACHE_KEY_SALT у wp-config.php, щоб керувати початковим префіксом кожного ключа."

#: includes/class-simple-redis-cache-admin.php:529
